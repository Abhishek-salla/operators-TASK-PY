# 1. Comparison Operators: Determine which number is larger
def larger_number(a, b):
    if a > b:
        print(f"{a} is larger than {b}")
    elif a < b:
        print(f"{b} is larger than {a}")
    else:
        print(f"{a} and {b} are equal")


# 2. Logical Operators: Range check and string length check
def logical_checks(num, text):
    # Check if number is between 10 and 20
    if num >= 10 and num <= 20:
        print(f"{num} is within the range 10–20")
    else:
        print(f"{num} is outside the range 10–20")

    # Check if string is not empty and length > 5
    if text and len(text) > 5:
        print(f"'{text}' is not empty and has length greater than 5")
    else:
        print(f"'{text}' does not meet the conditions")


# 3. Simple Calculator using conditional statements
def calculator(a, b, operation):
    if operation == "add":
        print(f"Result: {a + b}")
    elif operation == "subtract":
        print(f"Result: {a - b}")
    elif operation == "multiply":
        print(f"Result: {a * b}")
    elif operation == "divide":
        if b != 0:
            print(f"Result: {a / b}")
        else:
            print("Error: Division by zero")
    else:
        print("Invalid operation")


# 4. Age classification
def classify_age(age):
    if age < 13:
        print("Category: Child")
    elif age >= 13 and age < 20:
        print("Category: Teenager")
    elif age >= 20 and age < 60:
        print("Category: Adult")
    else:
        print("Category: Senior")


# 5. Simple login system
def login_system(username, password):
    # Hardcoded credentials
    valid_username = "admin"
    valid_password = "12345"

    if username == valid_username and password == valid_password:
        print("Login successful!")
    else:
        print("Invalid credentials.")


# --- Testing the functions ---
print("=== Larger Number ===")
larger_number(15, 20)

print("\n=== Logical Checks ===")
logical_checks(12, "PythonCode")

